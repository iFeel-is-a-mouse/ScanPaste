<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- =====================================================================
         Status bar spacer — blue background fills behind status bar.
         Height set dynamically to statusBarHeight in code.
         ===================================================================== -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/md_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- =====================================================================
         Toolbar — compact height, blue background, white title.
         ===================================================================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@color/md_primary"
        android:minHeight="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_bar_spacer"
        app:titleCentered="false"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="@color/md_on_primary">

        <!-- Game + Title + version badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_game"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:text="@string/ui_title"
                android:textColor="@color/md_on_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="@string/app_version"
                android:textColor="#80FFFFFF"
                android:textSize="7sp" />


        </LinearLayout>

        <!-- Right action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/btn_clear"
                android:textAllCaps="false"
                android:textColor="@color/md_on_primary"
                android:textSize="12sp"
                app:rippleColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/btn_copy"
                android:textAllCaps="false"
                android:textColor="@color/md_on_primary"
                android:textSize="12sp"
                app:rippleColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_readnote"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/btn_readnote"
                android:textAllCaps="false"
                android:textColor="@color/md_on_primary"
                android:textSize="12sp"
                app:rippleColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quicknote"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/btn_quicknote"
                android:textAllCaps="false"
                android:textColor="@color/md_on_primary"
                android:textSize="12sp"
                app:rippleColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/btn_save"
                android:textAllCaps="false"
                android:textColor="@color/md_on_primary"
                android:textSize="12sp"
                app:rippleColor="#33FFFFFF" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Thin divider -->
    <View
        android:id="@+id/toolbar_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.15"
        android:background="?attr/colorOutline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- =====================================================================
         Text editor — keyboard-aware via NestedScrollView + adjustResize
         ===================================================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_editor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/button_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_divider">

        <EditText
            android:id="@+id/et_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:allowUndo="false"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/editor_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:scrollbars="vertical"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:textSize="18sp" />

    </androidx.core.widget.NestedScrollView>

    <!-- =====================================================================
         Bottom button bar — [Undo] [Redo] [Append] [🖼️]
         ===================================================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/button_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/ll_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_undo"
                style="@style/Widget.ScanPaste.BottomButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_undo"
                android:enabled="false"
                android:text="@string/btn_undo"
                android:textSize="13sp"
                android:maxLines="1"
                app:icon="@drawable/ic_undo"
                        app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_redo"
                style="@style/Widget.ScanPaste.BottomButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_redo"
                android:enabled="false"
                android:text="@string/btn_redo"
                android:textSize="13sp"
                android:maxLines="1"
                app:icon="@drawable/ic_redo"
                        app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_append"
                style="@style/Widget.ScanPaste.BottomButton.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_append"
                android:text="@string/btn_append"
                android:textSize="13sp"
                android:maxLines="1"
                app:icon="@drawable/ic_scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gallery"
                style="@style/Widget.ScanPaste.BottomButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_gallery"
                android:text="@string/btn_gallery"
                android:textSize="13sp"
                app:icon="@drawable/ic_gallery"
                app:iconSize="14dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
